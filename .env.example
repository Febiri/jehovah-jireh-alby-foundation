# =============================================================================
# JEHOVAH JIREH ALBY FOUNDATION — Environment Configuration (EXAMPLE)
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# ----- Server Configuration -----
PORT=5000
NODE_ENV=production

# ----- Admin Login Credentials -----
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=change-me-strong-password

# Foundation Executive Admin
FOUNDATION_EMAIL=foundation@example.org
FOUNDATION_PASSWORD=change-me-strong-password

# ----- JWT Authentication Secret -----
# Generate a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"`
JWT_SECRET=change-me-to-a-long-random-secret

# ----- Foundation Contact -----
FOUNDATION_PHONE=0000000000
FOUNDATION_EMAIL_CONTACT=foundation@example.org
