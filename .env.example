# =============================================================================
# JEHOVAH JIREH ALBY FOUNDATION — Environment Configuration (EXAMPLE)
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# ----- Server Configuration -----
PORT=5000
NODE_ENV=production

# ----- Admin Login Credentials -----
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=change-me-strong-password

# Foundation Executive Admin
FOUNDATION_EMAIL=foundation@example.org
FOUNDATION_PASSWORD=change-me-strong-password

# ----- JWT Authentication Secret -----
# Generate a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"`
# Minimum 32 characters. The server refuses to start without this.
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
# Optional: token lifetime (default 8h). Use e.g. 2h in production.
JWT_TTL=8h

# ----- CORS -----
# Comma-separated public origins allowed to call the API. Empty = allow all (dev only).
# Example: CORS_ORIGINS=https://jjafoundation.org,https://www.jjafoundation.org
CORS_ORIGINS=

# ----- Foundation Contact -----
FOUNDATION_PHONE=0000000000
FOUNDATION_EMAIL_CONTACT=foundation@example.org

# ----- Persistence warning -----
# Default storage is local JSON (server/data/database.json) + local uploads.
# Ephemeral hosts wipe these on redeploy. Take regular backups via
# GET /api/admin/export (superadmin) until Postgres/S3 storage is configured.
